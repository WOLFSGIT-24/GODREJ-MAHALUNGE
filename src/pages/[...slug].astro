---
import AppRouter from "@/components/Router";
import { projectSnapshot as p } from "@/lib/data";
import "@/styles/global.css";

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'privacy-policy' } },
    { params: { slug: 'terms-and-conditions' } },
    { params: { slug: 'thank-you' } },
    { params: { slug: '404' } },
  ];
}

const SITE_NAME = 'Godrej Mahalunge';
const HOME_DESCRIPTION =
  'Godrej Mahalunge in West Pune: French-inspired luxury living. Premium 3 BHK residences & limited 4 BHK duplex homes starting ₹1.90 Cr onwards* across an 8.5-acre development with grand clubhouse, riverfront amenities, and seamless Hinjewadi & Baner–Balewadi connectivity.';

const pages: Record<string, { title: string; description: string; index: boolean }> = {
  home: {
    title: 'Godrej Mahalunge | French-Inspired Luxury Living in West Pune',
    description: HOME_DESCRIPTION,
    index: true,
  },
  'privacy-policy': {
    title: 'Privacy Policy | Godrej Mahalunge',
    description: 'How the Godrej Mahalunge website collects, uses and protects the details you share when you enquire.',
    index: true,
  },
  'terms-and-conditions': {
    title: 'Terms & Conditions | Godrej Mahalunge',
    description: 'Terms of use for the Godrej Mahalunge website, including project disclaimer and MahaRERA details.',
    index: true,
  },
  'thank-you': {
    title: 'Thank You | Godrej Mahalunge',
    description: 'Thank you for your enquiry about Godrej Mahalunge, West Pune.',
    index: false,
  },
  '404': {
    title: 'Page Not Found | Godrej Mahalunge',
    description: HOME_DESCRIPTION,
    index: false,
  },
};

const slug = Astro.params.slug ?? 'home';
const page = pages[slug] ?? pages.home;
const path = slug === 'home' ? '/' : `/${slug}`;

// Absolute URLs need the production domain: set SITE_URL when building for production.
const site = Astro.site;
const abs = (u: string) => (site ? new URL(u, site).href : u);
const canonical = site ? new URL(path, site).href : undefined;
const ogImage = abs('/godrej-banner-1.webp');

const jsonLd = slug === 'home'
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          name: SITE_NAME,
          ...(site ? { url: site.href } : {}),
          inLanguage: 'en-IN',
        },
        {
          '@type': 'ApartmentComplex',
          name: SITE_NAME,
          description: HOME_DESCRIPTION,
          ...(site ? { url: site.href } : {}),
          image: ogImage,
          telephone: p.phone,
          address: {
            '@type': 'PostalAddress',
            streetAddress: p.address.street,
            addressLocality: p.address.city,
            addressRegion: p.address.region,
            postalCode: p.address.postalCode,
            addressCountry: p.address.country,
          },
          amenityFeature: [
            '8.5 Acres Planned Development', '30,000 Sq. Ft. Clubhouse', '1 Lakh Sq. Ft. Riverfront Amenities', 'Swimming Pool',
            'Fully Equipped Gymnasium', 'Landscaped Gardens', 'Sports & Recreation Facilities', 'Dedicated Relaxation Spaces', 'Open Green Surroundings'
          ].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
          containedInPlace: { '@type': 'Place', name: 'Mahalunge, Pune' },
          brand: { '@type': 'Organization', name: p.developer },
          identifier: { '@type': 'PropertyValue', propertyID: 'MahaRERA', value: p.reraNumber },
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="en-IN" class="w-full h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content={page.index ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    {canonical && page.index && <link rel="canonical" href={canonical} />}
    <meta name="author" content={p.developer} />
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mahalunge, Pune" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Godrej Mahalunge — French-inspired luxury living in West Pune" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B1E34" />

    <!-- Above-the-fold resources -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/gt-ultra-median/GTUltraMedian-Regular.woff2" crossorigin />
    {slug === 'home' && (
      <>
        <link
          rel="preload"
          as="image"
          href="/godrej-banner-mobile-1.webp"
          media="(max-width: 1023px) and (orientation: portrait)"
          fetchpriority="high"
          type="image/webp"
        />
        <link
          rel="preload"
          as="image"
          href="/godrej-banner-1.webp"
          media="not all and (max-width: 1023px) and (orientation: portrait)"
          fetchpriority="high"
          type="image/webp"
        />
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Meta Pixel Code -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '891769890674491');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=891769890674491&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="w-full h-full bg-[#FAF7F1] text-[#0B1E34] antialiased">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>

    <!-- Readable content for crawlers and visitors without JavaScript -->
    <noscript>
      <main style="max-width:720px;margin:0 auto;padding:48px 20px;font-family:Georgia,serif;color:#0B1E34;line-height:1.7">
        <h1>Godrej Mahalunge: French-Inspired Luxury Living in West Pune</h1>
        <p>{HOME_DESCRIPTION}</p>
        <h2>Residences</h2>
        <p>Premium 3 BHK Residences &amp; Limited 4 BHK Duplex Homes starting ₹1.90 Cr onwards*.</p>
        <h2>Amenities</h2>
        <p>Approx. 30,000 Sq. Ft. Clubhouse and approx. 1 Lakh Sq. Ft. riverfront amenities including Swimming Pool, Gymnasium, Landscaped Gardens, and Sports Facilities.</p>
        <h2>Location</h2>
        <p>Mahalunge, Baner–Hinjewadi Corridor, West Pune. Close to Hinjewadi IT Park, Balewadi High Street, and NH-48.</p>
        <p>Call <a href={`tel:${p.phone.replace(/\s+/g, '')}`}>{p.phone}</a>. {p.rera}.</p>
      </main>
    </noscript>
  </body>
</html>
